@article{burgess_axiomatizing_2010,
	title = {Axiomatizing the {Logic} of {Comparative} {Probability}},
	volume = {51},
	issn = {0029-4527, 1939-0726},
	url = {https://projecteuclid.org/journals/notre-dame-journal-of-formal-logic/volume-51/issue-1/Axiomatizing-the-Logic-of-Comparative-Probability/10.1215/00294527-2010-008.full},
	doi = {10.1215/00294527-2010-008},
	abstract = {Often where an axiomatization of an intensional logic using only finitely many axioms schemes and rules of the simplest kind is unknown, one has a choice between an axiomatization involving an infinite family of axiom schemes and one involving nonstandard "Gabbay-style" rules. The present note adds another example of this phenomenon, pertaining to the logic comparative probability ("p is no more likely than q"). Peter Gärdenfors has produced an axiomatization involving an infinite family of schemes, and here an alternative using a "Gabbay-style" rule is offered. Both axiomatizations depend on the Kraft-Pratt-Seidenberg theorem from measurement theory.},
	number = {1},
	urldate = {2024-04-16},
	journal = {Notre Dame Journal of Formal Logic},
	author = {Burgess, John P.},
	month = jan,
	year = {2010},
	note = {Publisher: Duke University Press},
	keywords = {03B48, axiomatization, probability logic, qualitative probability},
	pages = {119--126},
	file = {Full Text PDF:files/16/Burgess - 2010 - Axiomatizing the Logic of Comparative Probability.pdf:application/pdf},
}

